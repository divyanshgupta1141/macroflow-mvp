# LLM Provider (Required for agent.py)
GROQ_API_KEY=your_groq_api_key_here

# Swiggy MCP Staging Credentials (Required for auth_server.py)
SWIGGY_CLIENT_ID=your_swiggy_client_id_here
SWIGGY_CLIENT_SECRET=your_swiggy_client_secret_here
# Update REDIRECT_URI to your deployed cloud URL in production (e.g., https://your-app.onrender.com/callback)
REDIRECT_URI=http://localhost:8000/callback

# Optional: Server Port (injected automatically by Render/Cloud hosts; defaults to 8000 locally)
PORT=8000

# Optional: Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here